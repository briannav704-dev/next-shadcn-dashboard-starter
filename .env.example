# Kouture Life OS — environment variables
# Copy to .env.local for local development. In production, set these in the
# Vercel project settings. Never commit real values.

# ── Local preview with sample data (ignored in production builds) ────────────
KOUTURE_DEMO_MODE=true

# ── Supabase (required for real use; overrides sample mode when set) ─────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" / publishable key. Safe in the browser: Row Level Security
# protects every table. NEVER put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The only email allowed to sign in.
OWNER_EMAIL=

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the deployed app, e.g. https://kouture.vercel.app
NEXT_PUBLIC_APP_URL=
# Your Nailzy booking page, shown as a shortcut on the Kouture dashboard.
NAILZY_BOOKING_URL=
# Secret iCal address of the Google Calendar Nailzy syncs your bookings into.
# Google Calendar → Settings → your calendar → Integrate calendar → "Secret address in iCal format".
# Treat it like a password: set it in Vercel only, never commit it.
NAILZY_CALENDAR_URL=

# ── Error tracking (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DISABLED=true
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
